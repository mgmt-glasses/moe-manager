# データベース
DATABASE_URL=postgres://postgres:postgres@localhost:5432/moe?sslmode=disable

# HTTP サーバー
PORT=8080

# Firebase 認証（ユーザー別 API の ID token 検証に必須）
FIREBASE_PROJECT_ID=your-firebase-project-id

# Vertex AI (Google Cloud)
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# ログ
LOG_LEVEL=info
